{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lunaeditor",
  "version": "1.0.0",
  "identifier": "cc.monnte.lunaeditor",
  "build": {
    "beforeDevCommand": "deno task start:web",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "deno task build:web",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luna Editor",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
